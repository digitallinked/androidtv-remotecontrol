// Copy this file to Secrets.xcconfig (git-ignored) and fill in the value.
// Without it the prod configurations use Google's AdMob test app id.
//
// The AdMob app id of the iOS app, from the AdMob console
// (Apps -> App settings). Never commit the real one.
ADMOB_APP_ID_PROD = ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
