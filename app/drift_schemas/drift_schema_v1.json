        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"devices\" (\"service_name\" TEXT NOT NULL, \"display_name\" TEXT NOT NULL, \"last_host\" TEXT NOT NULL, \"port\" INTEGER NOT NULL, \"nickname\" TEXT NULL, \"wol_mac\" TEXT NULL, \"server_key_pin\" TEXT NULL, \"last_connected_at\" INTEGER NOT NULL, PRIMARY KEY (\"service_name\"));"
