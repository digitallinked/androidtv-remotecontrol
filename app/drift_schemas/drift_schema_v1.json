      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"shortcuts\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"package\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"launch_link\" TEXT NOT NULL, \"icon_url\" TEXT NULL, \"is_custom\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_custom\" IN (0, 1)), \"custom_color\" INTEGER NULL, \"custom_icon\" TEXT NULL, \"position\" INTEGER NOT NULL);"
